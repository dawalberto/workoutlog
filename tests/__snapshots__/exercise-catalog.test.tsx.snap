exports[`ExerciseCatalog characterization > preserves the default catalog markup > catalog-default 1`] = `"<div id="exercise-catalog-page" class="min-h-screen bg-[#0D0D0D] text-white pb-28 pt-4 sm:pt-6"><div class="max-w-4xl mx-auto px-4 sm:px-6"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-white/[0.08]"><div><div class="flex items-center gap-2 mb-1"><span class="inline-flex items-center gap-1.5 text-[11px] font-extrabold uppercase tracking-widest text-[#00FF87]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dumbbell w-3.5 h-3.5" aria-hidden="true"><path d="M17.596 12.768a2 2 0 1 0 2.829-2.829l-1.768-1.767a2 2 0 0 0 2.828-2.829l-2.828-2.828a2 2 0 0 0-2.829 2.828l-1.767-1.768a2 2 0 1 0-2.829 2.829z"></path><path d="m2.5 21.5 1.4-1.4"></path><path d="m20.1 3.9 1.4-1.4"></path><path d="M5.343 21.485a2 2 0 1 0 2.829-2.828l1.767 1.768a2 2 0 1 0 2.829-2.829l-6.364-6.364a2 2 0 1 0-2.829 2.829l1.768 1.767a2 2 0 0 0-2.828 2.829z"></path><path d="m9.6 14.4 4.8-4.8"></path></svg> Catálogo Maestro</span></div><h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Biblioteca de Ejercicios</h1><p class="text-xs sm:text-sm text-[#A1A1AA] mt-0.5">Crea tus movimientos con imagen, video de técnica y series preconfiguradas.</p></div><div class="flex items-center gap-2"><button id="btn-new-catalog-exercise" type="button" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 min-h-[48px] rounded-2xl text-sm font-extrabold bg-[#00FF87] hover:bg-[#00e57a] text-black shadow-[0_0_20px_rgba(0,255,135,0.35)] transition-all active:scale-[0.97]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus w-5 h-