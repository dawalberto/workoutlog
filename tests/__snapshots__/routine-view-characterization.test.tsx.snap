exports[`RoutineView characterization > preserves edit mode markup > routine-edit 1`] = `"<div id="routine-view-container" class="min-h-screen bg-[#0D0D0D] text-white pb-32"><div class="sticky top-0 z-40 bg-[#121214]/90 backdrop-blur-xl border-b border-white/[0.08] shadow-lg pt-[env(safe-area-inset-top,0px)]"><div class="max-w-4xl mx-auto px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between gap-3"><div class="flex items-center gap-2 min-w-0"><button id="btn-back-to-routines" type="button" class="shrink-0 min-h-[44px] inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold rounded-xl text-zinc-300 hover:text-white bg-zinc-900 border border-white/10 hover:border-white/20 transition-all active:scale-[0.97]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left w-4 h-4" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> <span>Rutinas</span></button></div><div class="shrink-0 flex items-center p-1 bg-zinc-900/90 rounded-2xl border border-white/[0.08] shadow-inner"><button id="tab-mode-edit" type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold rounded-xl transition-all shrink-0 active:scale-95 bg-zinc-800 text-white border border-white/10 shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen-line w-3.5 h-3.5" aria-hidden="true"><path d="M13 21h8"></path><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg> <span>Editar</span></button><button id="tab-mode-execute" type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-extrabold rounded-xl transition-all shrink-0 active:scale-95 text-zinc-400 hover:text-white"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play w-3.5 h-3.5 fill-current" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg> <span>Entrenar</span></button></div></div></div><div class="max-w-4xl mx-auto px-4 sm:px-6 pt-4 sm:pt-6"><div class="bg-[#1C1C1E] rounded-2xl border border-white/[0.08] p-5 sm:p-6 shadow-xl mb-6"><div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4"><div class="flex-1 min-w-0"><div><label for="routine-name-input" class="block text-[11px] font-extrabold text-[#A1A1AA] uppercase tracking-wider mb-1">Nombre de la Rutina</label><input id="routine-name-input" type="text" placeholder="Ej: Torso Hipertrofia, Pierna Fuerza..." class="w-full text-xl sm:text-2xl font-black text-white bg-transparent border-b border-white/10 focus:border-[#00FF87] focus:outline-none pb-1 transition-colors" value="Rutina de prueba"/></div><div class="mt-3"><div><label for="routine-notes-input" class="block text-[11px] font-extrabold text-[#A1A1AA] uppercase tracking-wider mb-1">Notas / Objetivos</label><textarea id="routine-notes-input" rows="2" placeholder="Objetivos del día, notas sobre descansos, peso objetivo..." class="w-full text-base sm:text-sm text-zinc-200 bg-zinc-900 border border-white/10 rounded-xl p-3 focus:bg-black focus:border-[#00FF87] focus:outline-none transition-all">Objetivo de fuerza</textarea></div></div></div><div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center p-3 sm:p-4 rounded-xl bg-zinc-900 border border-white/10 shrink-0 w-full sm:w-auto shadow-inner"><span class="text-[10px] font-extrabold text-[#A1A1AA] uppercase tracking-wider">Tiempo Estimado</span><div class="flex items-center gap-1.5 text-white font